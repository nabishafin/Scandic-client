        {
            "name": "Payments",
            "item": [
                {
                    "name": "Initiate Purchase",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.paymentId) {",
                                    "    pm.environment.set(\"TRANSACTION_ID\", jsonData.paymentId);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{AUTH_TOKEN}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"walletId\": \"{{WALLET_ID}}\",\n    \"amount\": 100,\n    \"chain\": \"ETH\",\n    \"currency\": \"USDT\",\n    \"amountUSD\": 100\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{BASE_URL}}/api/v1/purchase",
                            "host": [
                                "{{BASE_URL}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "purchase"
                            ]
                        },
                        "description": "Initiate a new purchase transaction. Sets TRANSACTION_ID env var."
                    },
                    "response": []
                },
                {
                    "name": "Update Transaction",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{AUTH_TOKEN}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"hash\": \"0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{BASE_URL}}/api/v1/purchase/{{TRANSACTION_ID}}",
                            "host": [
                                "{{BASE_URL}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "purchase",
                                "{{TRANSACTION_ID}}"
                            ]
                        },
                        "description": "Update transaction with blockchain hash. Triggers verification and token allocation."
                    },
                    "response": []
                },
                {
                    "name": "Get Transaction Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{AUTH_TOKEN}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{BASE_URL}}/api/v1/purchase/{{TRANSACTION_ID}}",
                            "host": [
                                "{{BASE_URL}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "purchase",
                                "{{TRANSACTION_ID}}"
                            ]
                        },
                        "description": "Get details of a specific transaction. (Note: Ensure this route is implemented)"
                    },
                    "response": []
                }
            ]
        },
